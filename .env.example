# Copy this file to ".env" and fill in your own key. NEVER commit .env.
# Get a key from https://dashboard.sarvam.ai

SARVAM_API_KEY=your_sarvam_api_key_here

# --- Optional overrides (defaults shown; leave blank to use defaults) ---
# Speech-to-text model. Docs: saaras:v4 is the default, recommended model.
SARVAM_STT_MODEL=saaras:v4
# STT output mode: transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=transcribe
# Chat model used for the analysis. Docs: sarvam-105b (128K context).
SARVAM_CHAT_MODEL=sarvam-105b
